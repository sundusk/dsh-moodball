{
  "name": "@sundusk/dsh-moodball-status",
  "description": "DeepSeek Harness Agent status bridge for the MoodBall macOS desktop pet: a host-only plugin with HTTP compatibility and a local Unix socket transport.",
  "version": "0.5.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundusk/dsh-moodball.git"
  },
  "homepage": "https://github.com/sundusk/dsh-moodball#readme",
  "bugs": {
    "url": "https://github.com/sundusk/dsh-moodball/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "web-ui",
    "moodball",
    "status",
    "desktop"
  ],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "test:protocol": "pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.1.5-rc.2",
    "@types/node": "^22.20.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.7.2"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "BSD-3-Clause"
}
